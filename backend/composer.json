{
    "name": "glycoflow/backend",
    "description": "GlycoFlow PHP JSON API backend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GlycoFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlycoFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "check:syntax": "php tools/check-syntax.php",
        "check": [
            "@check:syntax",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite without watch mode.",
        "check:syntax": "Run a cross-platform PHP syntax check over the backend sources.",
        "check": "Run syntax checks followed by the test suite."
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

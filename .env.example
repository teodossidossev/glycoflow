# GlycoFlow environment configuration example.
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file or any secrets.

# Application
APP_ENV=local
APP_URL=http://localhost
APP_TIMEZONE=Europe/Sofia

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glycoflow
DB_USER=glycoflow
DB_PASSWORD=

# AI image analysis provider
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Storage paths (outside the public web root in production)
STORAGE_PATH=
TEMP_STORAGE_PATH=
LOG_PATH=

# Session cookie
SESSION_COOKIE_NAME=glycoflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
